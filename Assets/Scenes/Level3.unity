  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8156ca7dcd80838458188af90d20f70e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  buttonField: {fileID: 877008187}
  buttonPrefab: {fileID: 6740124892727561739, guid: ce1d5c66bf74d1a428f2e7c607232dff, type: 3}
  questionText: {fileID: 1687695518}
  questionImage: {fileID: 1780703975}
  answerImages: []
  audioSource: {fileID: 1450615449}
  correctSound: {fileID: 8300000, guid: 8bd084013a521a347a1d8a2648bbebb0, type: 3}
  wrongSound: {fileID: 8300000, guid: ef71cedaa7e7164438a5375699e6b11f, type: 3}
  questionTime: 20
  timerText: {fileID: 1542107214}
  ScoreCanvas: {fileID: 324602429}
  ScoreText: {fileID: 634240021}
  currentLevelIndex: 3
  nextLevelButton: {fileID: 709989}
  retryButton: {fileID: 298066422}
  selectLevelBtn1: {fileID: 1856554203}
  selectLevelBtn2: {fileID: 339024142}
  answerFontSize: 50
  questions:
  - questionText: Bintang raksasa ini menjadi pusat tata surya kita dan sumber utama
      cahaya serta panas. Apa itu?
    options:
    - Bulan
    - Bintang
    - Matahari
    - Mars
    correctAnswerIndex: 2
    questionImage: {fileID: 21300000, guid: 5b81bdc23c8b36a408cf13f0ad51370b, type: 3}
    answerImages:
    - {fileID: 21300000, guid: f1f52e6492838d4458139d23018309b6, type: 3}
    - {fileID: 21300000, guid: e67e1d9fb96e05642b3b2b435ad996c8, type: 3}
    - {fileID: 21300000, guid: f767afe0911dee24c8717e7cbfcf3661, type: 3}
    - {fileID: 21300000, guid: 5b81bdc23c8b36a408cf13f0ad51370b, type: 3}
    usesImageAnswers: 0
  - questionText: 'Planet ini adalah yang paling dekat dengan Matahari dan tidak
      memiliki atmosfer tebal, Planet kecil ini paling dekat ke Matahari, jadi siangnya
      super panas tapi malamnya dingin banget. Apa itu? '
    options:
    - Mars
    - Venus
    - Neptunus
    - Merkurius
    correctAnswerIndex: 3
    questionImage: {fileID: 21300000, guid: d64487cde35dd014baf2af5e87cf2645, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: Planet ini sangat panas karena efek rumah kaca ekstrem dan dikenal
      sebagai "bintang fajar". Apa itu?
    options:
    - Venus
    - Bumi
    - Saturnus
    - Uranus
    correctAnswerIndex: 0
    questionImage: {fileID: 21300000, guid: e67e1d9fb96e05642b3b2b435ad996c8, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: Planet ini satu-satunya yang diketahui mendukung kehidupan, dan
      Planet ini tempat tinggal kita semua. Apa itu?
    options:
    - Mars
    - Venus
    - Bumi
    - Yupiter
    correctAnswerIndex: 2
    questionImage: {fileID: 21300000, guid: c813c706b00884b4ea6fd4d88b948857, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: 'Planet ini dikenal sebagai "planet merah" karena permukaannya
      mengandung besi oksida,dan katanya bisa jadi tempat tinggal manusia di masa
      depan. Apa itu? '
    options:
    - Mars
    - Venus
    - Saturnus
    - Merkurius
    correctAnswerIndex: 0
    questionImage: {fileID: 21300000, guid: 692018017b370c144af0fcb43bd09fd8, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: Planet ini adalah yang terbesar di tata surya dan memiliki badai
      besar bernama "Great Red Spot" yang udah berlangsung ratusan tahun. Apa itu?
    options:
    - Neptunus
    - Saturnus
    - Uranus
    - Yupiter
    correctAnswerIndex: 3
    questionImage: {fileID: 21300000, guid: 496618e61d7328847ad8b10d64719faf, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: 'Planet ini terkenal karena cincin es raksasa yang bikin dia terlihat
      paling keren kalau dilihat dari teleskop. Apa itu? '
    options:
    - Yupiter
    - Saturnus
    - Uranus
    - Neptunus
    correctAnswerIndex: 1
    questionImage: {fileID: 21300000, guid: 539cb3992aac88f42ae89d3b4319cca5, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: Planet ini berputar miring hampir 90 derajat , dia berputar miring
      seperti tidur sambil muter dan tampak berwarna biru kehijauan . Apa itu?
    options:
    - Uranus
    - Saturnus
    - Mars
    - Merkurius
    correctAnswerIndex: 0
    questionImage: {fileID: 21300000, guid: f767afe0911dee24c8717e7cbfcf3661, type: 3}
    answerImages: []
    usesImageAnswers: 0
  - questionText: 'Planet ini adalah yang terjauh dari Matahari berwarna biru tua
      dan memiliki angin tercepat di tata surya. Apa itu? '
    options:
    - Uranus
    - Saturnus
    - Yupiter
    - Neptunus
    correctAnswerIndex: 3
    questionImage: {fileID: 21300000, guid: f1f52e6492838d4458139d23018309b6, type: 3}
    answerImages: []
    usesImageAnswers: 0
